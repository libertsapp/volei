{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'site estatico: nada para instalar'",
  "buildCommand": "rm -rf publicar && mkdir publicar && cp volei-dashboard.html publicar/index.html && cp sw.js publicar/sw.js",
  "outputDirectory": "publicar",
  "rewrites": [
    {
      "source": "/:apelido/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
